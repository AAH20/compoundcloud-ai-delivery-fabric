{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "location": {"type": "string", "defaultValue": "[resourceGroup().location]"},
    "suffix": {"type": "string", "defaultValue": "[uniqueString(resourceGroup().id)]"}
  },
  "variables": {
    "tags": {
      "project": "CompoundCloud AI Delivery Fabric",
      "purpose": "architecture-benchmark-evidence",
      "managedBy": "ARM",
      "website": "a2zsoc.com"
    }
  },
  "resources": [
    {
      "type": "Microsoft.OperationalInsights/workspaces",
      "apiVersion": "2023-09-01",
      "name": "[format('ccadf-law-{0}', parameters('suffix'))]",
      "location": "[parameters('location')]",
      "tags": "[variables('tags')]",
      "properties": {"retentionInDays": 30, "features": {"enableLogAccessUsingOnlyResourcePermissions": true}, "sku": {"name": "PerGB2018"}}
    },
    {
      "type": "Microsoft.Storage/storageAccounts",
      "apiVersion": "2023-05-01",
      "name": "[format('ccadf{0}', parameters('suffix'))]",
      "location": "[parameters('location')]",
      "tags": "[variables('tags')]",
      "sku": {"name": "Standard_LRS"},
      "kind": "StorageV2",
      "properties": {"allowBlobPublicAccess": false, "allowSharedKeyAccess": true, "minimumTlsVersion": "TLS1_2", "supportsHttpsTrafficOnly": true}
    },
    {
      "type": "Microsoft.Storage/storageAccounts/blobServices/containers",
      "apiVersion": "2023-05-01",
      "name": "[format('{0}/default/architecture-decisions', format('ccadf{0}', parameters('suffix')))]",
      "dependsOn": ["[resourceId('Microsoft.Storage/storageAccounts', format('ccadf{0}', parameters('suffix')))]"],
      "properties": {"publicAccess": "None"}
    },
    {
      "type": "Microsoft.Insights/components",
      "apiVersion": "2020-02-02",
      "name": "[format('ccadf-ai-{0}', parameters('suffix'))]",
      "location": "[parameters('location')]",
      "kind": "web",
      "tags": "[variables('tags')]",
      "properties": {"Application_Type": "web", "WorkspaceResourceId": "[resourceId('Microsoft.OperationalInsights/workspaces', format('ccadf-law-{0}', parameters('suffix')))]"},
      "dependsOn": ["[resourceId('Microsoft.OperationalInsights/workspaces', format('ccadf-law-{0}', parameters('suffix')))]"]
    }
  ],
  "outputs": {
    "logAnalyticsWorkspace": {"type": "string", "value": "[format('ccadf-law-{0}', parameters('suffix'))]"},
    "storageAccount": {"type": "string", "value": "[format('ccadf{0}', parameters('suffix'))]"},
    "applicationInsights": {"type": "string", "value": "[format('ccadf-ai-{0}', parameters('suffix'))]"},
    "evidenceStatement": {"type": "string", "value": "Azure evidence plane deployed for CompoundCloud architecture decisions and benchmark telemetry."}
  }
}

